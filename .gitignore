# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Compiled translations. The .po/.pot sources are committed; these are built
# from them -- by `indico i18n compile plugin` locally, and by the release
# workflow before it packages the wheel.
*.mo
messages-react.json

# Node / frontend build output
node_modules/
indico_blockschedule/static/dist/
webpack-build-config.json
url_map.json

# A local Indico core checkout (or symlink to one), read by tsconfig.json's "extends" and
# optionally pointed to by `.indico_source` for .eslintrc.js -- never the same on two machines.
indico-src
.indico_source

# Editor/OS noise
.DS_Store
*.swp
